PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/company_crm
JWT_SECRET=change-this-secret
ADMIN_EMAIL=admin@brainadz.com
ADMIN_PASSWORD=admin123456
DUMMY_EMPLOYEE_PASSWORD=Demo@12345
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
CRM_APP_URL=http://localhost:5173
MEETING_TIMEZONE=Asia/Kolkata
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=BrainADZ <quotations@brainadz.com>
COMPANY_EMAIL=quotations@brainadz.com
COMPANY_ADDRESS=Your registered company address
COMPANY_PHONE=+91 95404 68023, +91 92890 92708
COMPANY_WEBSITE=www.brainADZ.marketing
COMPANY_BRANCH_ADDRESS=Your branch office address

# CRM calling. Keep "device" for a normal tel: dialer without audio recording.
# Use "exotel" for server-side click-to-call with call recording.
CALL_PROVIDER=device
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_ACCOUNT_SID=your-exotel-account-sid
EXOTEL_CALLER_ID=your-exophone-number
EXOTEL_DEFAULT_AGENT_NUMBER=+919876543210
EXOTEL_API_HOST=api.exotel.com
PUBLIC_API_URL=https://your-api-domain.example.com
EXOTEL_WEBHOOK_TOKEN=replace-with-a-long-random-secret
# Optional public WAV played to both parties before connecting (recommended for recording consent).
EXOTEL_DISCLOSURE_AUDIO_URL=
